{
  "name": "santa-natura-estilos",
  "version": "1.0.0",
  "private": true,
  "description": "Genera tailwind.css, la hoja de estilos de la tienda. No forma parte de la web: nada de esta carpeta se sube al hosting.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i tailwind.entrada.css -o ../tailwind.css --minify",
    "dev": "tailwindcss -c tailwind.config.js -i tailwind.entrada.css -o ../tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.0"
  }
}
