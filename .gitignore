# Contraseña del panel de gestión (hash). Nunca al repositorio.
inc/admin-config.php

# Configuración del aviso emergente: la escribe el panel en el servidor, y lo
# que valga allí no tiene por qué ser lo que haya en el portátil.
inc/popup.json
inc/popup.json.tmp

# Copias de seguridad automáticas del catálogo que hace el panel al guardar.
inc/copias/

# Temporales de la escritura atómica de products.js
products.js.tmp

# Dependencias del generador de estilos. Se reinstalan con: cd build && npm install
build/node_modules/
build/package-lock.json

# Sistema
Thumbs.db
.DS_Store
desktop.ini

# Fotos originales que bajan scripts/componer-hero.php y generar-favicon.php.
# Se vuelven a descargar solas; no tiene sentido versionarlas.
scripts/.hero-fuentes/
